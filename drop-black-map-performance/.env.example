# Drop Black login (drop-acct-dev.weather.com)
# Copy this file to .env and fill in your own login. Never commit .env.
LOGIN_EMAIL=
LOGIN_PASSWORD=

# Optional: your own port for the config builder (default 3020)
# PORT=3021

# Hosted-login gate for the config builder (auth.js). All required when deployed.
# AMS_BASE_URL=https://bedrock-api-dev-east.weather.com/access-management
# ACCOUNT_APP_URL=https://drop-acct-dev.weather.com
# APP_PUBLIC_URL=https://drop-team-test.vercel.weather.com
# AMS_APPLICATION=dropblack
# Local runs on localhost can't get the .weather.com cookie, so skip the gate there only:
# AUTH_DISABLED=true
