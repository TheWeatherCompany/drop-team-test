# Drop Black login (drop-acct-dev.weather.com)
# Copy this file to .env and fill in your own login. Never commit .env.
LOGIN_EMAIL=
LOGIN_PASSWORD=

# Optional: your own port for the config builder (default 3020)
# PORT=3021

# Okta OIDC sign-in for the config builder (auth.js). All required when deployed.
# OKTA_ISSUER=https://your-org.okta.com/oauth2/default
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
# AUTH_SECRET=            # openssl rand -base64 32
# APP_PUBLIC_URL=https://drop-team-test.vercel.weather.com   # local: http://localhost:3020
# Skip the gate for local use only:
# AUTH_DISABLED=true
